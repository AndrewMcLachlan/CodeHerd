{
  "name": "codeherd",
  "version": "1.0.0-beta2",
  "description": "Manage Claude Code and Codex CLI sessions in persistent tabs",
  "author": "Andrew McLachlan",
  "license": "MIT",
  "homepage": "https://github.com/AndrewMcLachlan/CodeHerd",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndrewMcLachlan/CodeHerd.git"
  },
  "productName": "CodeHerd",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsx esbuild.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "dev:styling": "npm run build && electron . --styling",
    "dev:live": "npm run build && electron . --live-state",
    "rebuild": "electron-rebuild",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-abi": "^4.33.0",
    "node-pty": "^1.1.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^26.1.2",
    "electron": "^43.2.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "node-abi@<3.92.0": "3.92.0"
  }
}
